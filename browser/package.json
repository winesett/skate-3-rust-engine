{
  "name": "skateplus-browser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "characters": "node scripts/characters.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "prebuild": "node scripts/characters.mjs --public && npm run environments && node scripts/notices.mjs",
    "environments": "node scripts/environments.mjs",
    "assets": "npm run characters && npm run environments",
    "predev": "npm run assets"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/loaders": "^8.0.0"
  },
  "devDependencies": {
    "gltf-validator": "^2.0.0-dev.3.10",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
